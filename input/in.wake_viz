# ------------------------------------------------------------------
# in.wake_viz - watch the WSF wake form. Visualization only.
#
# Pulls in the production deck unchanged, then adds an image dump and
# a short run. Nothing here is used by the C++ harness.
#
# Run from spaceforge-xai/input :
#   mpirun -np 4 spa_ -in in.wake_viz -var runID wakeviz
#
# Produces ~100 frames in viz/wakeviz/ covering wake formation.
# ------------------------------------------------------------------

# Directories MUST exist before the include. The production deck creates
# "fix out print ... append ../data/raw/${runID}/..." and fix print opens
# its file at fix-creation time, so a missing dir fails the include itself.
# There is no root-level data/ in a fresh clone, so this is not optional.
#
# "index" style does not overwrite a value already set by -var on the
# command line, so this is only a fallback for a bare run.
#
# SPARTA's "shell mkdir" is a builtin that calls mkdir(2) on each argument.
# It does NOT accept -p, does NOT create parent directories, and ignores
# failures silently. So every level must be created separately, in order.
# Re-creating a level that already exists is a harmless no-op.
variable runID index wakeviz
shell mkdir ../data
shell mkdir ../data/raw
shell mkdir ../data/raw/${runID}
shell mkdir viz
shell mkdir viz/${runID}

include in.wake_harness

# ------------------------------------------------------------------
# Camera notes (box is x -13..12, y -5..5, z -5..5)
#   center s 0.56 0.5 0.5  -> puts x = +1.0 m at frame center
#   zoom 2.0               -> frames about 12.5 m of x, roughly -5..+7
#   view 90 90             -> camera on +y, level. x runs left to right,
#                             which is the classic wake profile shot.
#   pdiam 0.025            -> render size only, not physical. Tune freely.
# ------------------------------------------------------------------
# Grammar is: dump ID style mix-ID N file color diam [keywords]
# The mix-ID is required and easy to miss. Omitting it makes SPARTA read
# the filename as the frequency, which fails as "Invalid dump frequency"
# (output.cpp reads atoi(arg[3])). "all" is a built-in mixture.
dump wake image all 10 viz/${runID}/wake_*.ppm type type &
     size 1600 900 &
     zoom 2.0 &
     center s 0.56 0.5 0.5 &
     view 90 90 &
     up 0 0 1 &
     pdiam 0.025 &
     surf proc 0.0 &
     box yes 0.02

# pad 5 keeps frames in lexical order so ffmpeg globs them correctly.
#
# Colors are restricted to primaries/secondaries that exist in every
# SPARTA palette. Names with numeric suffixes (gray30) and exotic names
# (dodgerblue) are X11/ImageMagick conventions and are NOT in the table;
# they fail as "Invalid color in dump_modify command".
dump_modify wake pad 5 backcolor black boxcolor white
dump_modify wake scolor * white

# Species order from in.wake_harness line 28: O N N2 O2 H2O
dump_modify wake pcolor 1 cyan          # O   - dominant freestream
dump_modify wake pcolor 2 green         # N
dump_modify wake pcolor 3 blue          # N2
dump_modify wake pcolor 4 red           # O2
dump_modify wake pcolor 5 yellow        # H2O - outgassed off the wake face

# 1000 steps = 3 full domain transits. Wake is established by ~500.
run 1000
